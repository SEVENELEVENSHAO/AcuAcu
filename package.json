{
  "name": "acu-five-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sources:extract": "node scripts/extract-clinical-sources.mjs",
    "sources:search": "node scripts/search-clinical-sources.mjs",
    "audit:sync": "node scripts/clinical-audit.mjs --sync",
    "audit:check": "node scripts/clinical-audit.mjs --check",
    "audit:report": "node scripts/clinical-audit.mjs --report",
    "content:verify": "esbuild scripts/verify-content.ts --bundle --platform=node --format=esm --outfile=.clinical-cache/verify-content.mjs && node .clinical-cache/verify-content.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "pdfjs-dist": "^6.1.200"
  }
}
